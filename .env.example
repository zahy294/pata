# Names only. Real values go in .env.local, which git ignores.
# Code reads only the names listed here. SETUP.md says who provides each one.

# Sepolia (ENSv2). Direct RPC for Foundry scripts and our server's own transactions.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Registers pata.eth and digipin.eth, deploys the digipin resolver. Project owner only.
DEPLOYER_PRIVATE_KEY=

# Server-side gas relay: tops up household keys on Sepolia and Arkiv, and registers household names. Project owner only.
RELAY_PRIVATE_KEY=

# Arkiv testnet (Rabdi, chain 7794095). Access key from https://hub.arkiv.network/access-keys
# Not a secret: it ships in the app, locked to the site's Origins.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=

# Address AI, server only.
ANTHROPIC_API_KEY=

# Speech (Sarvam), server only.
SARVAM_API_KEY=

# Pins the static build on IPFS at deploy time.
PINATA_JWT=

# Optional: verifies the digipin resolver on Etherscan. Without it, --verify uses Sourcify.
ETHERSCAN_API_KEY=

# ---- Browser (Next.js inlines NEXT_PUBLIC_* into the static build; never put a secret here) ----

# The Worker's URL. Local: http://localhost:8787 (npm run server:dev). Deployed: https://pata-server.<account>.workers.dev
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Same value as ARKIV_ACCESS_KEY. Add http://localhost:3000 and the Pages host to its Origins.
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# pata.eth's own UserRegistry proxy. The owner posts it in the team chat after P0-2.
NEXT_PUBLIC_PATA_REGISTRY=
# 1 = writes go direct (P0). 0 = writes through Nox (P1-4).
NEXT_PUBLIC_DIRECT_WRITES=1

# ---- Worker (server/) ----
# Secrets: `npx wrangler secret put <NAME>` for ANTHROPIC_API_KEY, SARVAM_API_KEY, RELAY_PRIVATE_KEY,
# ARKIV_ACCESS_KEY. For `npm run server:dev`, put them in server/.dev.vars (git ignores it).
# Vars live in server/wrangler.jsonc: ALLOWED_ORIGINS, KILL_SWITCH, DAILY_SPEND_CAP_CENTS,
# PATA_REGISTRY_ADDRESS, SEPOLIA_RPC_URL, ARKIV_RPC_URL.
